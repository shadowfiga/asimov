<?xml version="1.0" encoding="utf-8"?>
<ScreenSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>MainMenuScreen</Name>
  <State>
    <Name>Default</Name>
    <Variable Type="string" Name="PlayButton.Parent" SetsValue="true">
      <Value xsi:type="xsd:string">RootPanel</Value>
    </Variable>
    <Variable Type="string" Name="PlayButton.Text" SetsValue="true">
      <Value xsi:type="xsd:string">Play Game</Value>
    </Variable>
    <Variable Type="float" Name="PlayButton.Width" SetsValue="true">
      <Value xsi:type="xsd:float">350</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="PlayButton.WidthUnits" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="string" Name="QuitButton.Parent" SetsValue="true">
      <Value xsi:type="xsd:string">RootPanel</Value>
    </Variable>
    <Variable Type="string" Name="QuitButton.Text" SetsValue="true">
      <Value xsi:type="xsd:string">Quit</Value>
    </Variable>
    <Variable Type="float" Name="QuitButton.Width" SetsValue="true">
      <Value xsi:type="xsd:float">350</Value>
    </Variable>
    <Variable Type="float" Name="RootPanel.StackSpacing" SetsValue="true">
      <Value xsi:type="xsd:float">12</Value>
    </Variable>
    <Variable Type="float" Name="RootPanel.Width" SetsValue="true">
      <Value xsi:type="xsd:float">350</Value>
    </Variable>
    <Variable Type="HorizontalAlignment" Name="RootPanel.XOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="RootPanel.XUnits" SetsValue="true">
      <Value xsi:type="xsd:int">6</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="RootPanel.YOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="RootPanel.YUnits" SetsValue="true">
      <Value xsi:type="xsd:int">7</Value>
    </Variable>
    <Variable Type="float" Name="Title.Height" SetsValue="true">
      <Value xsi:type="xsd:float">48</Value>
    </Variable>
    <Variable Type="HorizontalAlignment" Name="Title.HorizontalAlignment" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="string" Name="Title.Parent" SetsValue="true">
      <Value xsi:type="xsd:string">RootPanel</Value>
    </Variable>
    <Variable Type="string" Name="Title.Text" SetsValue="true">
      <Value xsi:type="xsd:string">Fantoma</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="Title.VerticalAlignment" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="float" Name="Title.Width" SetsValue="true">
      <Value xsi:type="xsd:float">350</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="Title.WidthUnits" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
  </State>
  <Instance Name="RootPanel" BaseType="Controls/StackPanel" />
  <Instance Name="Title" BaseType="Text" />
  <Instance Name="PlayButton" BaseType="Controls/ButtonStandard" />
  <Instance Name="QuitButton" BaseType="Controls/ButtonStandard" />
  <Behaviors />
</ScreenSave>
